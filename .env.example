# Copy to .env for local dev. In Netlify: Site → Environment variables (same names), then redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (conversion tracking). Default ID is set in code; override here if needed.
# VITE_META_PIXEL_ID=961689956497983
# Set to true to disable pixel locally: VITE_META_PIXEL_DISABLED=true

# Meta Conversions API — set ONLY in Supabase Edge Function secrets (never Netlify / never commit):
#   META_CAPI_ACCESS_TOKEN=your_system_user_token
#   META_PIXEL_ID=961689956497983  (optional override)
#   META_TEST_EVENT_CODE=TEST12345  (optional, for Events Manager test mode)
